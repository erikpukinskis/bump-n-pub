{
  "name": "bump-n-pub",
  "version": "0.30.0",
  "description": "Publish npm packages and prepare MultiplayerDB service releases",
  "type": "module",
  "bin": "./dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "yarn@4.11.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test": "yarn build && vitest run",
    "prepack": "yarn build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "semver": "^7.7.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/semver": "^7.7.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/erikpukinskis/bump-n-pub.git"
  },
  "homepage": "https://github.com/erikpukinskis/bump-n-pub"
}
